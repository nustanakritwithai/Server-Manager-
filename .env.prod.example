# Template for the Windows VPS. Do not copy this file into production as-is.
# deploy/windows/bootstrap.ps1 writes .env.prod with generated passwords and an admin token.
# .env.prod is gitignored.

SIMCORE_ENV=production
SIMCORE_DATABASE_URL=postgresql+psycopg://simcore:CHANGE_ME@127.0.0.1:5432/simcore
SIMCORE_ADMIN_TOKEN=CHANGE_ME
# Player access-token signing secret. At least 32 random characters.
# Leave this line out of a real .env.prod: bootstrap.ps1 and update.ps1 generate it
# when it is missing, shorter than 32 characters, or a known placeholder. The value is not printed.
# The API refuses to start in production if it is still missing or weak.
# SIMCORE_PLAYER_TOKEN_SECRET=
# SIMCORE_PLAYER_ACCESS_TTL_SECONDS=900
# SIMCORE_PLAYER_REFRESH_TTL_SECONDS=2592000
# Production default is off. development and test leave dev-login on without this flag.
# SIMCORE_ENABLE_DEV_LOGIN=false
# SIMCORE_PLAYER_LOGIN_MAX_FAILURES=5
# SIMCORE_PLAYER_LOGIN_IP_MAX_FAILURES=20
# SIMCORE_PLAYER_LOGIN_WINDOW_SECONDS=900
# SIMCORE_PLAYER_LOGIN_LOCKOUT_SECONDS=900
# SIMCORE_COMMAND_RATE_LIMIT=30
# SIMCORE_COMMAND_RATE_WINDOW_SECONDS=60
# New-player start. Optional. Unset keeps the defaults in src/simcore/config.py
# (2000/2000/800/400, rates 40/40/20/10, militia:1, distance 8, map -500..500).
# No migration. update.ps1 does not need these lines.
# SIMCORE_START_WOOD=2000
# SIMCORE_START_FOOD=2000
# SIMCORE_START_IRON=800
# SIMCORE_START_GOLD=400
# SIMCORE_START_WOOD_RATE=40
# SIMCORE_START_FOOD_RATE=40
# SIMCORE_START_IRON_RATE=20
# SIMCORE_START_GOLD_RATE=10
# SIMCORE_START_UNITS=militia:1
# SIMCORE_START_CITY_NAME={name} Home
# SIMCORE_START_ARMY_NAME={name} Army
# SIMCORE_START_MIN_DISTANCE=8
# SIMCORE_START_MAP_MIN=-500
# SIMCORE_START_MAP_MAX=500
SIMCORE_ENABLE_ADMIN=false
SIMCORE_EMBEDDED_WORKER=false
SIMCORE_CORS_ORIGINS=https://nustanakritwithai.github.io,http://127.0.0.1:8080,http://localhost:8080
SIMCORE_WORKER_POLL_SECONDS=1.0

# Monitoring (all optional). Unset keeps these defaults. No new variable is required.
# Samples are one row per metric about this often. 0 turns periodic samples off.
# SIMCORE_MONITOR_SAMPLE_SECONDS=60
# Rows older than this many days are deleted (1-30).
# SIMCORE_MONITOR_RETENTION_DAYS=7
# The API process records API latency history. The worker records the other series.
# SIMCORE_MONITOR_API_SAMPLER=true
# Disk to measure with shutil.disk_usage. Empty uses the drive of the working directory
# (C:\ when the service runs from C:\simcore\app). A missing path is NOT INSTRUMENTED.
# SIMCORE_MONITOR_DISK_PATH=
# Optional commit SHA. If empty, the process tries `git rev-parse HEAD` once.
# SIMCORE_GIT_COMMIT=
#
# Thresholds. For the first group, warn must be below critical (higher is worse).
# Heartbeat age: warn STALE, critical DOWN. Defaults 15s and 60s.
# SIMCORE_MONITOR_HEARTBEAT_WARN_SECONDS=15
# SIMCORE_MONITOR_HEARTBEAT_CRITICAL_SECONDS=60
# Game-time lag of the oldest due unprocessed event. Defaults 15s and 120s.
# SIMCORE_MONITOR_EVENT_LAG_WARN_SECONDS=15
# SIMCORE_MONITOR_EVENT_LAG_CRITICAL_SECONDS=120
# Wall-clock age of that same event. Defaults 15s and 120s.
# SIMCORE_MONITOR_OLDEST_DUE_WARN_SECONDS=15
# SIMCORE_MONITOR_OLDEST_DUE_CRITICAL_SECONDS=120
# SIMCORE_MONITOR_QUEUE_PENDING_WARN=500
# SIMCORE_MONITOR_QUEUE_PENDING_CRITICAL=5000
# SIMCORE_MONITOR_QUEUE_DUE_WARN=25
# SIMCORE_MONITOR_QUEUE_DUE_CRITICAL=200
# SIMCORE_MONITOR_FAILED_WARN=1
# SIMCORE_MONITOR_FAILED_CRITICAL=10
# SIMCORE_MONITOR_RETRIED_WARN=1
# SIMCORE_MONITOR_RETRIED_CRITICAL=20
# Visible processing-row age. Defaults 30s and 120s.
# SIMCORE_MONITOR_PROCESSING_WARN_SECONDS=30
# SIMCORE_MONITOR_PROCESSING_CRITICAL_SECONDS=120
# API 5xx rate over the last 5 minutes in this API process. Defaults 0.01 and 0.05.
# SIMCORE_MONITOR_API_ERROR_RATE_WARN=0.01
# SIMCORE_MONITOR_API_ERROR_RATE_CRITICAL=0.05
# SIMCORE_MONITOR_API_5XX_WARN=1
# SIMCORE_MONITOR_API_5XX_CRITICAL=10
# API p95 latency in milliseconds. Defaults 300 and 1000.
# SIMCORE_MONITOR_API_P95_WARN_MS=300
# SIMCORE_MONITOR_API_P95_CRITICAL_MS=1000
# SIMCORE_MONITOR_DB_RTT_WARN_MS=50
# SIMCORE_MONITOR_DB_RTT_CRITICAL_MS=200
# Pool utilization fraction. Defaults 0.8 and 0.95.
# SIMCORE_MONITOR_DB_POOL_WARN=0.8
# SIMCORE_MONITOR_DB_POOL_CRITICAL=0.95
# Database size in megabytes. Defaults 10240 (10 GiB) and 40960 (40 GiB).
# SIMCORE_MONITOR_DB_SIZE_WARN_MB=10240
# SIMCORE_MONITOR_DB_SIZE_CRITICAL_MB=40960
# Free disk in megabytes. Warn must be ABOVE critical (lower is worse).
# Defaults 5120 (5 GiB) and 2048 (2 GiB).
# SIMCORE_MONITOR_DISK_FREE_WARN_MB=5120
# SIMCORE_MONITOR_DISK_FREE_CRITICAL_MB=2048
# Host CPU and memory are percents. Warn must be below critical.
# Defaults are CPU 90/98 and memory 85/95. A saturated sample can be CRITICAL.
# SIMCORE_MONITOR_CPU_WARN_PERCENT=90
# SIMCORE_MONITOR_CPU_CRITICAL_PERCENT=98
# SIMCORE_MONITOR_MEMORY_WARN_PERCENT=85
# SIMCORE_MONITOR_MEMORY_CRITICAL_PERCENT=95
#
# Off-site backup status (all optional). deploy/windows/backup.ps1 writes the file.
# On Windows an empty path means C:\simcore\backups\backup-status.json.
# Age of the last verified off-site backup. Warn must be below critical.
# Defaults: warn after 26 hours, critical after 50 hours.
# SIMCORE_BACKUP_STATUS_PATH=
# SIMCORE_BACKUP_WARN_HOURS=26
# SIMCORE_BACKUP_CRITICAL_HOURS=50
#
# Read by the Windows backup scripts, not by the game server. Defaults are used when unset.
# Local copies stay small because C: is tight. Drive keeps the history.
# The script refuses to dump when free space minus the estimated dump
# (pg_database_size times the margin) would leave less than the minimum.
# SIMCORE_BACKUP_DIR=C:\simcore\backups
# SIMCORE_BACKUP_REMOTE=gdrive:simcore-backups
# SIMCORE_BACKUP_RCLONE_CONFIG=C:\simcore\backup\rclone.conf
# SIMCORE_BACKUP_LOG=C:\simcore\logs\backup.log
# SIMCORE_BACKUP_KEEP_LOCAL=2
# SIMCORE_BACKUP_KEEP_DAILY=14
# SIMCORE_BACKUP_KEEP_WEEKLY=8
# Minimum free bytes to leave on the drive after the estimated dump, in megabytes.
# SIMCORE_BACKUP_MIN_FREE_MB=1024
# Estimated dump size is pg_database_size multiplied by this margin.
# SIMCORE_BACKUP_DUMP_MARGIN=1.5

# sslip.io embeds the VPS address: 157-85-96-139.sslip.io -> 157.85.96.139
# Override this when you have a real domain, then run deploy/windows/update.ps1.
API_DOMAIN=157-85-96-139.sslip.io
API_PORT=8741
# Optional Let's Encrypt account email. Leave empty to omit it.
ACME_EMAIL=

# Written by bootstrap.ps1. Not read by the game server.
POSTGRES_SUPER_PASSWORD=CHANGE_ME
SIMCORE_DB_PASSWORD=CHANGE_ME
SIMCORE_INSTALL_ROOT=C:\simcore

# Written by deploy/windows/coexist-apache.ps1 when Apache already owns this VPS.
# The game server ignores these. update.ps1 keeps them so the Caddyfile still
# proxies every non-API host to Apache on localhost.
# SIMCORE_APACHE_HTTP=127.0.0.1:8080
# SIMCORE_APACHE_HTTPS=127.0.0.1:8443
# SIMCORE_PUBLIC_IP=157.85.96.139
# SIMCORE_APACHE_NAMES=
