# Template for the Windows VPS. Do not copy this file into production as-is.
# deploy/windows/bootstrap.ps1 writes .env.prod with generated passwords and an admin token.
# .env.prod is gitignored.

SIMCORE_ENV=production
SIMCORE_DATABASE_URL=postgresql+psycopg://simcore:CHANGE_ME@127.0.0.1:5432/simcore
SIMCORE_ADMIN_TOKEN=CHANGE_ME
SIMCORE_ENABLE_ADMIN=false
SIMCORE_EMBEDDED_WORKER=false
SIMCORE_CORS_ORIGINS=https://nustanakritwithai.github.io,http://127.0.0.1:8080,http://localhost:8080
SIMCORE_WORKER_POLL_SECONDS=1.0

# sslip.io embeds the VPS address: 157-85-96-139.sslip.io -> 157.85.96.139
# Override this when you have a real domain, then run deploy/windows/update.ps1.
API_DOMAIN=157-85-96-139.sslip.io
API_PORT=8741
# Optional Let's Encrypt account email. Leave empty to omit it.
ACME_EMAIL=

# Written by bootstrap.ps1. Not read by the game server.
POSTGRES_SUPER_PASSWORD=CHANGE_ME
SIMCORE_DB_PASSWORD=CHANGE_ME
SIMCORE_INSTALL_ROOT=C:\simcore
