# Copy to .env for local overrides. These are development placeholders, not production secrets.
# Docker Compose sets the same values itself; you only need this file for a bare-metal run.

# Postgres URL the API and worker use. The password matches docker-compose.yml.
SIMCORE_DATABASE_URL=postgresql+psycopg://simcore:simcore@127.0.0.1:5432/simcore

# Tests refuse to truncate any database whose name is not simcore_test.
SIMCORE_TEST_DATABASE_URL=postgresql+psycopg://simcore:simcore@127.0.0.1:5432/simcore_test

# development keeps the admin API on. production turns it off unless SIMCORE_ENABLE_ADMIN=1.
SIMCORE_ENV=development

# Placeholder checked by X-Admin-Token. Not a real credential.
# Production refuses to start with this value. The Windows bootstrap generates a token instead.
SIMCORE_ADMIN_TOKEN=dev-admin

# Signs player access tokens. The development default is refused in production.
# deploy/windows/update.ps1 generates a random value into .env.prod when it is missing or weak.
# SIMCORE_PLAYER_TOKEN_SECRET=dev-player-token-secret-not-for-production
# Access token lifetime in seconds (minimum 60). Default 900.
# SIMCORE_PLAYER_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds. Default 2592000 (30 days).
# SIMCORE_PLAYER_REFRESH_TTL_SECONDS=2592000
# Dev-login is on when SIMCORE_ENV is development or test. Set true to force it on in production.
# SIMCORE_ENABLE_DEV_LOGIN=false
# Failed logins per account and per IP before a temporary lockout. Defaults 5 and 20.
# SIMCORE_PLAYER_LOGIN_MAX_FAILURES=5
# SIMCORE_PLAYER_LOGIN_IP_MAX_FAILURES=20
# SIMCORE_PLAYER_LOGIN_WINDOW_SECONDS=900
# SIMCORE_PLAYER_LOGIN_LOCKOUT_SECONDS=900
# Player commands per access-token player. Defaults 30 per 60 seconds.
# SIMCORE_COMMAND_RATE_LIMIT=30
# SIMCORE_COMMAND_RATE_WINDOW_SECONDS=60

# Optional password login. Leave the hash empty until deploy/windows/set-admin-password.ps1 writes it.
# That script stores a scrypt hash and an HMAC session secret. It does not store the password.
# SIMCORE_ADMIN_PASSWORD_HASH=
# SIMCORE_ADMIN_SESSION_SECRET=
# SIMCORE_ADMIN_SESSION_VERSION=1
# SIMCORE_ADMIN_SESSION_TTL_SECONDS=2592000

# Comma-separated browser origins. Development also allows the localhost ports below
# even when this list omits them. The GitHub Pages origin is the site, not the /Server-Manager-/ path.
SIMCORE_CORS_ORIGINS=https://nustanakritwithai.github.io,http://127.0.0.1:8080,http://localhost:8080

# Leave false. The API and the worker are separate processes. true runs the worker loop inside the API.
SIMCORE_EMBEDDED_WORKER=false

# Worker idle delay when the event queue is empty, in seconds.
SIMCORE_WORKER_POLL_SECONDS=1.0

# Monitoring defaults. All optional. See docs/MONITORING.md.
# SIMCORE_MONITOR_SAMPLE_SECONDS=60
# SIMCORE_MONITOR_RETENTION_DAYS=7
# SIMCORE_MONITOR_API_SAMPLER=true
# SIMCORE_MONITOR_DISK_PATH=
# Host CPU and memory are percents. Warn must be below critical.
# Defaults are CPU 90/98 and memory 85/95. A saturated sample can be CRITICAL.
# SIMCORE_MONITOR_CPU_WARN_PERCENT=90
# SIMCORE_MONITOR_CPU_CRITICAL_PERCENT=98
# SIMCORE_MONITOR_MEMORY_WARN_PERCENT=85
# SIMCORE_MONITOR_MEMORY_CRITICAL_PERCENT=95
# SIMCORE_GIT_COMMIT=
# Backup status file for backup.last_success. Optional. See docs/BACKUP_DR.md.
# SIMCORE_BACKUP_STATUS_PATH=
# SIMCORE_BACKUP_WARN_HOURS=26
# SIMCORE_BACKUP_CRITICAL_HOURS=50
